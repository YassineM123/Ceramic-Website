TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=xauusd_copy_bot

# Comma-separated channel usernames or numeric IDs.
# Examples: @goldsignals,@my_private_channel,-1001234567890
TELEGRAM_CHANNELS=

# Broker symbol can have suffixes such as XAUUSDm or GOLD.
MT5_SYMBOL=XAUUSD

# Safety defaults: dry run logs trades without sending them to MT5.
DRY_RUN=true
LOT_SIZE=0.01
MAX_LOT_SIZE=0.05
DEVIATION_POINTS=30
MAGIC_NUMBER=260604

# Market signals such as "BUY GOLD NOW" execute immediately when DRY_RUN=false.
# Pending signals such as "BUY LIMIT 2345" place a pending order.
ALLOW_MARKET_EXECUTION=true

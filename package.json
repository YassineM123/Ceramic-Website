{
  "name": "ecommerce-admin-monorepo",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "build": "npm run build:frontend",
    "build:frontend": "vite build --config frontend/vite.config.ts",
    "build:admin": "vite build --config admin/vite.config.ts",
    "build:all": "npm run build:frontend && npm run build:admin",
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "vite --config frontend/vite.config.ts --port 5173 --strictPort",
    "dev:admin": "vite --config admin/vite.config.ts --port 5174 --strictPort",
    "dev:backend": "node backend/src/server.mjs",
    "start:backend": "node backend/src/server.mjs",
    "smoke:api": "powershell -ExecutionPolicy Bypass -File scripts/smoke-api.ps1",
    "db:migrate": "node backend/scripts/migrate-json-to-sqlite.mjs",
    "db:verify": "node backend/scripts/verify-sqlite-integrity.mjs",
    "test:storage": "node backend/scripts/runtime-storage-regression.mjs",
    "test:backups": "node backend/scripts/backup-retention-regression.mjs",
    "test:transactions": "node backend/scripts/sqlite-transaction-regression.mjs",
    "test:security": "npm run test:storage && npm run test:backups && npm run test:transactions",
    "test:social-agent": "node backend/scripts/social-agent-regression.mjs",
    "lint": "eslint \"frontend/src/**/*.{ts,tsx}\" \"admin/src/**/*.{ts,tsx}\" \"backend/**/*.mjs\" \"scripts/**/*.mjs\""
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "7.3.5",
    "@mui/material": "7.3.5",
    "@popperjs/core": "2.11.8",
    "@radix-ui/react-accordion": "1.2.3",
    "@radix-ui/react-alert-dialog": "1.1.6",
    "@radix-ui/react-aspect-ratio": "1.1.2",
    "@radix-ui/react-avatar": "1.1.3",
    "@radix-ui/react-checkbox": "1.1.4",
    "@radix-ui/react-collapsible": "1.1.3",
    "@radix-ui/react-context-menu": "2.2.6",
    "@radix-ui/react-dialog": "1.1.6",
    "@radix-ui/react-dropdown-menu": "2.1.6",
    "@radix-ui/react-hover-card": "1.1.6",
    "@radix-ui/react-label": "2.1.2",
    "@radix-ui/react-menubar": "1.1.6",
    "@radix-ui/react-navigation-menu": "1.2.5",
    "@radix-ui/react-popover": "1.1.6",
    "@radix-ui/react-progress": "1.1.2",
    "@radix-ui/react-radio-group": "1.2.3",
